
use v5.14;
use warnings;

use require::relative q (test-helper.pl);

testing_classification { & it_is_sub_declaration };
arrange_document       { <<'END_OF_DOCUMENT' };
sub foo { ... }
my sub foo { ... }
sub bar;
my sub bar;
sub { }
END_OF_DOCUMENT

assume_ppi q (should match function definition(s))
	=> expect     => expect_nodeset (
		expect_element (PPI::Statement::Sub:: => q (sub bar;)),
		expect_element (PPI::Statement::Sub:: => q (my sub bar;)),
	);

had_no_warnings;
done_testing;

